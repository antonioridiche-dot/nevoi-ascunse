{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pestedespartire",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "client/dist",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    // Pana cumpar domeniul pestedespartire.ro, site-ul ruleaza pe workers.dev.
    // Cand domeniul e gata, se schimba DOAR linia asta + se adauga ruta in Cloudflare.
    "VITE_FRONTEND_URL": "https://pestedespartire.antonio-ridiche.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pestedespartire-db",
      "database_id": "2e5b02e7-dddd-4279-ad62-a8b0bd7d7ff5",
      "migrations_dir": "drizzle/d1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BOOKS",
      "bucket_name": "pestedespartire-books"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "routes": []
}
