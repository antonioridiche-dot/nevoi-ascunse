{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nevoi-ascunse",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "client/dist",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    // Brandul rămâne „tevreauinapoi", dar site-ul stă pe nevoi-ascunse.ro, cu
    // două ramuri: /tevreauinapoi (împăcare) și /pestedespartire (zero despărțiri).
    "VITE_FRONTEND_URL": "https://nevoi-ascunse.ro"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nevoi-ascunse-app-db",
      "database_id": "8e960795-e126-47df-bcdc-c61779a37282",
      "migrations_dir": "drizzle/d1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BOOKS",
      "bucket_name": "nevoi-ascunse-books"
    }
  ],
  "routes": [
    { "pattern": "nevoi-ascunse.ro/*", "zone_name": "nevoi-ascunse.ro" },
    { "pattern": "www.nevoi-ascunse.ro/*", "zone_name": "nevoi-ascunse.ro" }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
